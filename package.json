{
  "name": "@ornie/react",
  "version": "0.1.0",
  "private": true,
  "description": "Ornie design system — React components on the Riverbed theme.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && pnpm run build:css && pnpm run build:grid",
    "build:css": "esbuild src/styles/index.css --bundle --outfile=dist/styles.css --loader:.woff2=file --asset-names=fonts/[name] --log-level=warning",
    "build:grid": "esbuild src/grid/grid-entry.tsx --bundle --format=iife --global-name=OrnieGrid --outfile=dist/grid/ornie-grid.js --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --log-level=warning",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:contrast": "node scripts/check-contrast.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:all": "pnpm audit:tokens && pnpm audit:contrast && pnpm audit:a11y",
    "changeset": "changeset",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.12.1",
    "esbuild": "^0.24.0",
    "lucide-static": "^1.24.0",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
