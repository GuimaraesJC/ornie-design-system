{
  "$meta": {
    "name": "Riverbed",
    "description": "Ornie design tokens — single source of truth (D-44). Edit THIS file, then run `pnpm tokens` to regenerate src/styles/tokens.css, tokens/Tokens.swift and tokens/Tokens.kt. Never hand-edit the generated files.",
    "refSyntax": "{group.key} references a Layer 1 palette value; {@key} references another Layer 2 token in the same theme."
  },
  "layer1": {
    "palette": {
      "river": {
        "$comment": "accent, muted teal — water",
        "50": "#edf4f1",
        "100": "#d7e7e0",
        "200": "#b4d0c5",
        "300": "#8bb2a4",
        "400": "#679487",
        "500": "#4c7d70",
        "600": "#3e685d",
        "700": "#32544b",
        "800": "#26413a",
        "900": "#1b2f2a"
      },
      "sand": {
        "$comment": "warm taupe neutrals — earth",
        "0": "#ffffff",
        "50": "#f8f5f1",
        "100": "#efeae3",
        "200": "#e2dacf",
        "300": "#cfc3b4",
        "400": "#aea08f",
        "500": "#7f7365",
        "600": "#6a5f52",
        "700": "#4e453b",
        "800": "#38312a",
        "900": "#241e18",
        "950": "#1d1813",
        "1000": "#16110d"
      },
      "$comments": {
        "sand.950": "dark theme: page",
        "sand.1000": "dark theme: deepest earth (mirrors the sand-0 white anchor)"
      },
      "fur": {
        "$comment": "identity brown: avatars, highlights",
        "50": "#f4ede5",
        "100": "#e8d9c8",
        "200": "#d6bda3",
        "300": "#bf9d7d",
        "500": "#8b6a4f",
        "700": "#5e4433",
        "900": "#362619"
      },
      "moss": {
        "$comment": "status green (muted by design)",
        "50": "#edf2ea",
        "100": "#d8e4d2",
        "200": "#b9cfae",
        "300": "#97b489",
        "500": "#567a4e",
        "600": "#46653f",
        "700": "#375031",
        "900": "#202e1d"
      },
      "clay": {
        "$comment": "status amber (muted by design)",
        "50": "#f6efe1",
        "100": "#ecdfc0",
        "200": "#e0cda1",
        "300": "#cfb178",
        "500": "#a98038",
        "600": "#8c6828",
        "700": "#6f521f",
        "900": "#392b16"
      },
      "rust": {
        "$comment": "status danger (muted by design); no rust-200: rust is excluded from avatar tones",
        "50": "#f7ece8",
        "100": "#eed6cd",
        "300": "#cd9681",
        "500": "#a55c47",
        "600": "#8f4936",
        "700": "#733a2b",
        "900": "#3f221a"
      }
    },
    "typography": {
      "font-sans": "'Manrope', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "text-xs": "12px",
      "text-sm": "13px",
      "text-md": "15px",
      "text-lg": "17px",
      "text-xl": "20px",
      "text-2xl": "24px",
      "text-3xl": "30px",
      "text-4xl": "38px",
      "leading-tight": "1.25",
      "leading-normal": "1.5",
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-semibold": "600",
      "weight-bold": "700",
      "weight-extrabold": "800"
    },
    "spacing": {
      "$comment": "4px grid",
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-10": "40px",
      "space-12": "48px",
      "space-16": "64px"
    },
    "radius": {
      "radius-xs": "6px",
      "radius-sm": "8px",
      "radius-md": "12px",
      "radius-lg": "16px",
      "radius-full": "999px",
      "$comments": {
        "radius-md": "controls",
        "radius-lg": "cards, modals"
      }
    },
    "shadow": {
      "$comment": "elevation (warm-tinted, low)",
      "shadow-sm": "0 1px 2px rgba(36, 30, 24, 0.06)",
      "shadow-md": "0 2px 8px rgba(36, 30, 24, 0.08), 0 1px 2px rgba(36, 30, 24, 0.05)",
      "shadow-lg": "0 12px 32px rgba(36, 30, 24, 0.14), 0 2px 8px rgba(36, 30, 24, 0.06)"
    },
    "motion": {
      "$comment": "the ONLY durations/eases components may use; all collapse to 1ms under prefers-reduced-motion (media query emitted in the token layer, so every component inherits it)",
      "duration-quick": "120ms",
      "duration-gentle": "220ms",
      "duration-fast": "120ms",
      "duration-normal": "180ms",
      "ease-out": "cubic-bezier(0.2, 0, 0.2, 1)",
      "ease-inout": "cubic-bezier(0.45, 0, 0.25, 1)",
      "ease": "cubic-bezier(0.2, 0, 0.2, 1)",
      "duration-spin": "900ms",
      "spin-state": "running",
      "$comments": {
        "duration-fast": "DEPRECATED since 0.2.0 — use duration-quick; remove at 0.3.0",
        "duration-normal": "DEPRECATED since 0.2.0 — use duration-quick/gentle; remove at 0.3.0",
        "ease": "DEPRECATED since 0.2.0 — use ease-out; remove at 0.3.0",
        "duration-spin": "Spinner rotation period; paused (not sped to 1ms) under reduced motion",
        "spin-state": "animation-play-state for continuous animations; reduced motion flips it to paused"
      },
      "$reducedMotion": {
        "duration-quick": "1ms",
        "duration-gentle": "1ms",
        "duration-fast": "1ms",
        "duration-normal": "1ms",
        "spin-state": "paused"
      }
    },
    "z": {
      "z-modal": "1000",
      "z-tooltip": "1100",
      "z-toast": "1200"
    }
  },
  "layer2": {
    "light": {
      "$colorScheme": "light",
      "bg": "{sand.50}",
      "surface": "{sand.0}",
      "surface-sunken": "{sand.100}",
      "surface-hover": "{sand.100}",
      "surface-inverse": "{sand.900}",
      "hover": "{sand.50}",
      "selected": "{river.100}",
      "track": "{sand.100}",
      "done": "{river.300}",
      "border": "{sand.200}",
      "border-strong": "{sand.300}",
      "border-hover": "{sand.400}",
      "border-subtle": "rgba(36, 30, 24, 0.05)",
      "text": "{sand.900}",
      "text-muted": "{sand.600}",
      "text-subtle": "{sand.500}",
      "text-on-accent": "#ffffff",
      "text-inverse": "#ffffff",
      "inverse-surface": "{@surface-inverse}",
      "inverse-text": "{@text-inverse}",
      "accent": "{river.500}",
      "accent-hover": "{river.600}",
      "accent-active": "{river.700}",
      "accent-subtle": "{river.50}",
      "accent-subtle-border": "{river.200}",
      "accent-text": "{river.600}",
      "accent-text-hover": "{river.700}",
      "success": "{moss.500}",
      "success-subtle": "{moss.50}",
      "success-text": "{moss.700}",
      "warning": "{clay.500}",
      "warning-subtle": "{clay.50}",
      "warning-text": "{clay.700}",
      "danger": "{rust.500}",
      "danger-hover": "{rust.600}",
      "danger-active": "{rust.700}",
      "danger-subtle": "{rust.50}",
      "danger-text": "{rust.600}",
      "tone-river": "{river.100}",
      "tone-river-ink": "{river.700}",
      "tone-fur": "{fur.100}",
      "tone-fur-ink": "{fur.700}",
      "tone-moss": "{moss.100}",
      "tone-moss-ink": "{moss.700}",
      "tone-clay": "{clay.100}",
      "tone-clay-ink": "{clay.700}",
      "tone-stone": "{sand.200}",
      "tone-stone-ink": "{sand.700}",
      "project-river": "{river.500}",
      "project-moss": "{moss.500}",
      "project-clay": "{clay.500}",
      "project-fur": "{fur.500}",
      "project-rust": "{rust.500}",
      "focus-ring": "{river.500}",
      "focus-ring-danger": "{rust.500}",
      "overlay": "rgba(36, 30, 24, 0.4)",
      "$comments": {
        "hover": "row/item hover wash",
        "selected": "selected row / text-selection wash",
        "track": "progress tracks, placeholder bars, rails",
        "done": "completed-state ink/wash — core product state; never red, never loud",
        "surface-inverse": "toast/badge dark-on-light surfaces",
        "text-inverse": "ink on inverse surfaces",
        "border-subtle": "hairline for elevated surfaces",
        "inverse-surface": "DEPRECATED since 0.2.0 — use surface-inverse; remove at 0.3.0",
        "inverse-text": "DEPRECATED since 0.2.0 — use text-inverse; remove at 0.3.0",
        "tone-river": "decorative identity tints (Avatar, ProjectDot). Rust is deliberately excluded — no alarm-adjacent colors on people",
        "project-river": "ProjectDot identity mids — same in both themes (500s read on both grounds); semantic so themes can retarget (D-61). Rust allowed here (projects aren't people)",
        "focus-ring": "the ONE focus color: outline 2px solid, offset 2px, everywhere",
        "focus-ring-danger": "DEPRECATED since 0.2.0 — focus is identical everywhere; remove at 0.3.0",
        "overlay": "modal/sheet scrim wash"
      }
    },
    "dark": {
      "$colorScheme": "dark",
      "bg": "{sand.950}",
      "surface": "{sand.900}",
      "surface-sunken": "{sand.1000}",
      "surface-hover": "{sand.800}",
      "surface-inverse": "{sand.100}",
      "hover": "{sand.800}",
      "selected": "{river.700}",
      "track": "{sand.700}",
      "done": "{river.600}",
      "border": "{sand.700}",
      "border-strong": "{sand.600}",
      "border-hover": "{sand.500}",
      "border-subtle": "rgba(248, 245, 241, 0.08)",
      "text": "{sand.100}",
      "text-muted": "{sand.400}",
      "text-subtle": "{sand.500}",
      "text-on-accent": "#ffffff",
      "text-inverse": "{sand.900}",
      "inverse-surface": "{@surface-inverse}",
      "inverse-text": "{@text-inverse}",
      "accent": "{river.500}",
      "accent-hover": "{river.600}",
      "accent-active": "{river.700}",
      "accent-subtle": "{river.900}",
      "accent-subtle-border": "{river.700}",
      "accent-text": "{river.300}",
      "accent-text-hover": "{river.200}",
      "success": "{moss.500}",
      "success-subtle": "{moss.900}",
      "success-text": "{moss.300}",
      "warning": "{clay.500}",
      "warning-subtle": "{clay.900}",
      "warning-text": "{clay.300}",
      "danger": "{rust.500}",
      "danger-hover": "{rust.600}",
      "danger-active": "{rust.700}",
      "danger-subtle": "{rust.900}",
      "danger-text": "{rust.300}",
      "tone-river": "{river.900}",
      "tone-river-ink": "{river.200}",
      "tone-fur": "{fur.900}",
      "tone-fur-ink": "{fur.200}",
      "tone-moss": "{moss.900}",
      "tone-moss-ink": "{moss.200}",
      "tone-clay": "{clay.900}",
      "tone-clay-ink": "{clay.200}",
      "tone-stone": "{sand.800}",
      "tone-stone-ink": "{sand.200}",
      "project-river": "{river.500}",
      "project-moss": "{moss.500}",
      "project-clay": "{clay.500}",
      "project-fur": "{fur.500}",
      "project-rust": "{rust.500}",
      "focus-ring": "{river.300}",
      "focus-ring-danger": "{rust.300}",
      "overlay": "rgba(0, 0, 0, 0.55)",
      "shadow-sm": "0 1px 2px rgba(10, 7, 4, 0.5)",
      "shadow-md": "0 2px 8px rgba(10, 7, 4, 0.55), 0 1px 2px rgba(10, 7, 4, 0.4)",
      "shadow-lg": "0 12px 32px rgba(10, 7, 4, 0.65), 0 2px 8px rgba(10, 7, 4, 0.5)",
      "$comments": {
        "border-subtle": "sand-50 veil: edge-lights elevated cards",
        "overlay": "scrim, deeper than light",
        "shadow-sm": "Layer 1 override: light shadows are sand-900 tints at 6-14% alpha — invisible on a #1d1813 page",
        "tone-river": "dim the decorative tints — the light pastels would be the loudest thing on a dark page; same five hues, deep grounds, pale ink"
      }
    }
  }
}
